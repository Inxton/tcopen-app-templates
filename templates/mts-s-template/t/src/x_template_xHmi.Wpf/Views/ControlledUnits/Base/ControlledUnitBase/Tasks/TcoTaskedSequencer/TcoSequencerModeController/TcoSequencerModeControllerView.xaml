<UserControl
    x:Class="x_template_xPlc.TcoSequencerModeControllerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vortex="http://vortex.mts/xaml" xmlns:vortexs="http://vortex.security.mts/xaml"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <d:UserControl.DataContext>
        <vortex:TcoSequencerModeControllerViewModel />
    </d:UserControl.DataContext>
    <Grid DataContext="{Binding }">
        <StackPanel>
            <Button Command="{Binding _changeMode}" Content="{Binding _mode.Cyclic, Converter={vortex:SequenceModeDescriptionInConverter}}"/>
            <UniformGrid Columns="3"
                         Visibility="{Binding _mode.Cyclic, Converter={vortex:SequenceModeVisibleInConverter},ConverterParameter=StepMode}" >
                <vortexs:PermissionBox  Permissions="Administrator|sequencer_step" SecurityMode="Disabled">
                    <Button Command="{Binding _stepBackward}">⏪</Button>
                </vortexs:PermissionBox>
                <Button Command="{Binding _stepIn}">Step in</Button>
                <vortexs:PermissionBox  Permissions="Administrator|sequencer_step" SecurityMode="Disabled">
                    <Button Command="{Binding _stepForward}">⏩</Button>
                </vortexs:PermissionBox>
            </UniformGrid>
        </StackPanel>
    </Grid>
</UserControl>
